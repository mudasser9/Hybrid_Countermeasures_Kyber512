## proc ::tcl::clock::Initialize {} {
## 
##     rename ::tcl::clock::Initialize {}
## 
##     variable LibDir
## 
##     # Define the Greenwich time zone
## 
##     proc InitTZData {} {
## 	variable TZData
## 	array unset TZData
## 	set TZData(:Etc/GMT) {
## 	    {-9223372036854775808 0 0 GMT}
## 	}
